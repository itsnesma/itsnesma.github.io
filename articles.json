---
layout: null
permalink: /articles.json
---
[{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%-d %B %Y" | jsonify }},
    "type": {{ post.type | default: "" | jsonify }},
    "summary": {{ post.summary | default: post.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},
    "minutes": {{ post.content | number_of_words | divided_by: 200 | plus: 1 }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
